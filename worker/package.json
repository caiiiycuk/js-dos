{
  "name": "jsdos-bundle-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that packages a DOS game folder into a .jsdos bundle",
  "scripts": {
    "build": "node scripts/build-bundles.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "wrangler": "^3.0.0"
  }
}
